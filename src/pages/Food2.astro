---
import Layout from "../layouts/Layout.astro";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Acme&family=Roboto:ital,wght@0,400;0,700;1,900&display=swap"
  rel="stylesheet"
/>

<Layout title="Malay Cursine">
  <main>
    <h1 class="title">Foodies Corner</h1>

    <p class="category">Malay Cursine</p>

    <img class="image" src="public/foodimage2/NasiLemak.jpg" />
    <p class="foodlist">Nasi Lemak</p>
  </main>
</Layout>

<style>
  .title {
    font-size: 3pc;
    font-family: inter;
    text-align: center;
    font-weight: bold;
  }
  .category {
    font-size: 25px;
    font-family: acme;
    background-color: grey;
    display: inline-block;
    margin-left: 15px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 20px;
  }
  .foodlist {
    font-family: inter;
  }
</style>
